---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="wrap page-top center">
    <p class="eyebrow">404</p>
    <h1>That page doesn't exist.</h1>
    <p class="lede">It may have moved when the blog migrated. Try the latest posts or the course catalog.</p>
    <div class="hero-actions center">
      <a class="btn" href="/">Latest posts</a>
      <a class="btn btn-ghost" href="https://www.lufsec.com/collections">Courses</a>
    </div>
  </section>
</Base>
