---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import Pager from '../../../components/Pager.astro';
import { getPosts, paginate } from '../../../lib/posts';
import { SITE } from '../../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, string>();
  posts.forEach((p) => p.data.tagSlugs.forEach((s, i) => tags.set(s, p.data.tags[i])));
  return [...tags].flatMap(([slug, name]) => {
    const tagged = posts.filter((p) => p.data.tagSlugs.includes(slug));
    return paginate(tagged, SITE.postsPerPage, `/tag/${slug}/`).map((page) => ({
      params: { tag: slug, page: page.n === 1 ? undefined : `page/${page.n}` },
      props: { page, name, count: tagged.length },
    }));
  });
}
const { page, name, count } = Astro.props;
---
<Base title={`${name} posts`} description={`LufSec articles about ${name}.`}>
  <section class="wrap page-top">
    <p class="eyebrow">Tag</p>
    <h1 class="section-title">{name} <span class="muted">· {count} post{count === 1 ? '' : 's'}</span></h1>
    <div class="grid">
      {page.items.map((post) => <PostCard post={post} />)}
    </div>
    <Pager {...page} />
  </section>
</Base>
